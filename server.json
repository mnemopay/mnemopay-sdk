{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.mnemopay/sdk",
  "description": "Trust OS for AI agents: governed memory, payments, reputation, approvals, and audit evidence.",
  "repository": {
    "url": "https://github.com/mnemopay/mnemopay-sdk",
    "source": "github"
  },
  "websiteUrl": "https://mnemopay.com",
  "version": "1.14.2",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@mnemopay/sdk",
      "version": "1.14.2",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y",
          "valueHint": "-y"
        },
        {
          "type": "positional",
          "value": "--package=@mnemopay/sdk",
          "valueHint": "--package=@mnemopay/sdk"
        },
        {
          "type": "positional",
          "value": "mnemopay-mcp",
          "valueHint": "mnemopay-mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "MNEMOPAY_API_KEY",
          "description": "MnemoPay API key from https://mnemopay.com/dashboard",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "MNEMOPAY_PERSIST_DIR",
          "description": "Directory where the local ledger + memory store persist (default: ~/.mnemopay)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
